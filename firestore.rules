rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nombres de los 10 Super Seniors: s1 ... s10
    match /seniors/{id} {
      allow read: if true;
      allow create, update: if id.matches('s([1-9]|10)')
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow delete: if false;
    }

    // Casillas de cada tablilla: s<tablilla>-<0..31>
    match /casillas/{id} {
      allow read: if true;
      allow create, update: if id.matches('s([1-9]|10)-([0-9]|[12][0-9]|3[01])')
        && request.resource.data.keys().hasOnly(['nombre', 'estado'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 40
        && request.resource.data.estado in ['aporto', 'prometido'];
      allow delete: if id.matches('s([1-9]|10)-([0-9]|[12][0-9]|3[01])');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
